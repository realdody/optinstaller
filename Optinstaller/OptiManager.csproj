<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SharpSevenZipVersion>2.0.36</SharpSevenZipVersion>
    <AssemblyName>OptiManager</AssemblyName>
    <Product>OptiManager</Product>
    <Title>OptiManager</Title>
    <RootNamespace>Optinstaller</RootNamespace>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RtssHooksCompatibilityObjectPath>$(MSBuildProjectDirectory)\RTSSHooksCompatibility\RTSSHooksCompatibility.obj</RtssHooksCompatibilityObjectPath>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
  </ItemGroup>

  <!-- Include the prebuilt object so NativeAOT publish will link it into the native EXE. -->
  <ItemGroup>
    <NativeLibrary Include="RTSSHooksCompatibility\RTSSHooksCompatibility.obj" Condition="Exists('$(RtssHooksCompatibilityObjectPath)')" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="GameFinder" Version="4.9.0" />
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <PackageReference Include="SharpSevenZip" Version="$(SharpSevenZipVersion)" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="ValveKeyValue" Version="0.13.1.398" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <!-- SharpSevenZip native library deployment -->
  <!-- Native runtime assets for Windows x86/x64 are automatically copied by the Content items below -->
  <ItemGroup>
    <!-- Native runtime assets for Windows x86/x64 -->
    <Content Include="$(NuGetPackageRoot)\sharpsevenzip\$(SharpSevenZipVersion)\runtimes\win-x86\native\7z.dll" Condition="Exists('$(NuGetPackageRoot)\sharpsevenzip\$(SharpSevenZipVersion)\runtimes\win-x86\native\7z.dll')">
      <Link>x86\7z.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="$(NuGetPackageRoot)\sharpsevenzip\$(SharpSevenZipVersion)\runtimes\win-x64\native\7z.dll" Condition="Exists('$(NuGetPackageRoot)\sharpsevenzip\$(SharpSevenZipVersion)\runtimes\win-x64\native\7z.dll')">
      <Link>x64\7z.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <!-- Check whether the prebuilt RTSS compatibility object is available for NativeAOT linking. -->
  <Target Name="BuildRTSSCompatibilityModule" AfterTargets="Build">
    <Message Importance="high" Text="RTSSHooksCompatibility: using the prebuilt .obj for NativeAOT linking." />
    <ItemGroup>
      <_RTSSObj Include="$(RtssHooksCompatibilityObjectPath)" Condition="Exists('$(RtssHooksCompatibilityObjectPath)')" />
    </ItemGroup>
    <Message Importance="high" Text="RTSSHooksCompatibility.obj found at %(_RTSSObj.Identity)" Condition=" '@(_RTSSObj)' != '' " />
    <Warning Text="RTSSHooksCompatibility.obj not found. NativeAOT publish will not include the object; the EXE will not export RTSSHooksCompatibility." Condition=" '@(_RTSSObj)' == '' " />
  </Target>

  <!-- Publish a NativeAOT native EXE after every build so the final executable exports RTSSHooksCompatibility. -->
  <!-- Run NativeAOT publish after build, but avoid recursion: when this target launches 'dotnet publish'
       it passes SkipNativeAotPublish=true so the child publish won't run this target again. -->
  <!-- Only publish NativeAOT for Release builds. Debug builds use the normal managed output. -->
  <Target Name="PublishNativeAot" AfterTargets="Build" DependsOnTargets="BuildRTSSCompatibilityModule" Condition=" '$(SkipNativeAotPublish)' != 'true' and '$(Configuration)' == 'Release' ">
    <Message Importance="high" Text="Starting NativeAOT publish (Release) to produce a native EXE with RTSSHooksCompatibility linked in..." />
    <Error Text="RTSSHooksCompatibility.obj is required for Release NativeAOT publish. Rebuild it from Optinstaller\RTSSHooksCompatibility\RTSSHooksCompatibility.c before publishing." Condition="!Exists('$(RtssHooksCompatibilityObjectPath)')" />
    <!-- Run dotnet publish for this project, enabling NativeAOT and including the prebuilt .obj via NativeLibrary above. -->
    <Exec Command='dotnet publish "$(MSBuildProjectFullPath)" -r win-x64 -c $(Configuration) -p:PublishAot=true -p:SelfContained=true -p:SkipNativeAotPublish=true -o "$(OutDir)native-publish"' />
    <Message Importance="high" Text="NativeAOT publish completed; check $(OutDir)native-publish for the patched native EXE." />
  </Target>
</Project>
