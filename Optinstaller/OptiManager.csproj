<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SharpSevenZipVersion>2.0.36</SharpSevenZipVersion>
    <AssemblyName>OptiManager</AssemblyName>
    <Product>OptiManager</Product>
    <Title>OptiManager</Title>
    <RootNamespace>Optinstaller</RootNamespace>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RtssExportPatcherProject>$(MSBuildThisFileDirectory)..\BuildTools\RtssExportPatcher\RtssExportPatcher.csproj</RtssExportPatcherProject>
    <RtssExportPatcherExe>$(MSBuildThisFileDirectory)..\BuildTools\RtssExportPatcher\bin\$(Configuration)\net10.0\RtssExportPatcher.exe</RtssExportPatcherExe>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="GameFinder" Version="4.9.0" />
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <PackageReference Include="SharpSevenZip" Version="$(SharpSevenZipVersion)" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="ValveKeyValue" Version="0.13.1.398" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <!-- SharpSevenZip native library deployment -->
  <!-- Native runtime assets for Windows x86/x64 are automatically copied by the Content items below -->
  <ItemGroup>
    <!-- Native runtime assets for Windows x86/x64 -->
    <Content Include="$(NuGetPackageRoot)\sharpsevenzip\$(SharpSevenZipVersion)\runtimes\win-x86\native\7z.dll" Condition="Exists('$(NuGetPackageRoot)\sharpsevenzip\$(SharpSevenZipVersion)\runtimes\win-x86\native\7z.dll')">
      <Link>x86\7z.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="$(NuGetPackageRoot)\sharpsevenzip\$(SharpSevenZipVersion)\runtimes\win-x64\native\7z.dll" Condition="Exists('$(NuGetPackageRoot)\sharpsevenzip\$(SharpSevenZipVersion)\runtimes\win-x64\native\7z.dll')">
      <Link>x64\7z.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <Target Name="BuildRtssExportPatcher" Condition="'$(OS)' == 'Windows_NT' and Exists('$(RtssExportPatcherProject)')">
    <MSBuild Projects="$(RtssExportPatcherProject)" Targets="Build" Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="PatchRtssExportAfterBuild" AfterTargets="Build" DependsOnTargets="BuildRtssExportPatcher" Condition="'$(OS)' == 'Windows_NT' and Exists('$(TargetDir)$(AssemblyName).exe') and Exists('$(RtssExportPatcherExe)')">
    <Exec Command="&quot;$(RtssExportPatcherExe)&quot; &quot;$(TargetDir)$(AssemblyName).exe&quot;" />
  </Target>

  <Target Name="PatchRtssExportAfterPublish" AfterTargets="Publish" DependsOnTargets="BuildRtssExportPatcher" Condition="'$(OS)' == 'Windows_NT' and Exists('$(PublishDir)$(AssemblyName).exe') and Exists('$(RtssExportPatcherExe)')">
    <Exec Command="&quot;$(RtssExportPatcherExe)&quot; &quot;$(PublishDir)$(AssemblyName).exe&quot;" />
  </Target>
</Project>
